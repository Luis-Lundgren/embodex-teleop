# Embodex Teleop Environment Configuration

# Server Port (default: 8500)
PORT=8500

# Security & Authentication Settings
# EMBODEX_SECURITY_MODE: hardware (default with robot), simulation, or local (loopback-only)
EMBODEX_SECURITY_MODE=hardware

# Permanent Service API Token (used by server-side embodex-web proxy and automation CLI)
EMBODEX_API_TOKEN="permanent-service-bearer-token"

# Shared WebSocket Ticket Secret (used to verify short-lived signed browser tickets from embodex-web)
EMBODEX_WS_TICKET_SECRET="shared-ws-ticket-signing-secret"

# Allowed CORS Origins (comma-separated, e.g. for web frontend)
EMBODEX_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional Database Configuration (PostgreSQL / Prisma)
# If set, teleoperation episodes will automatically sync to the database
# DATABASE_URL="postgresql://user:password@localhost:5432/embodex?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/embodex?schema=public"

# Logging verbosity: debug, info, warning, error
LOG_LEVEL=info
